# Copy to .env, configure locally, and restart the server. Never commit your key.
REPOTRACTION_AI_URL=https://api.openai.com/v1
REPOTRACTION_AI_MODEL=gpt-6-luna
REPOTRACTION_AI_KEY=
REPOTRACTION_AI_ALLOW_REMOTE=1
REPOTRACTION_AI_RESPONSE_FORMAT=json_schema
REPOTRACTION_AI_API_KIND=responses
REPOTRACTION_AI_REASONING_EFFORT=medium
REPOTRACTION_AI_STREAMING=1
REPOTRACTION_AI_MAX_CALLS=8
# Set explicit positive budgets to enable paid calls.
REPOTRACTION_AI_MAX_COST_USD=0
REPOTRACTION_AI_TOTAL_BUDGET_USD=0
REPOTRACTION_AI_BUDGET_ID=my-explicit-allowance
# Verify current prices for the exact configured model before use.
REPOTRACTION_AI_INPUT_USD_PER_MILLION=0.10
REPOTRACTION_AI_OUTPUT_USD_PER_MILLION=0.50
REPOTRACTION_AI_MAX_PROMPT_BYTES=180000
