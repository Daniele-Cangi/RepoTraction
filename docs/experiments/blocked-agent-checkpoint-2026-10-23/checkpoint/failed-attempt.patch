diff --git a/sympy/core/compatibility.py b/sympy/core/compatibility.py
index 1f1ec06d7..14f2a3abf 100644
--- a/sympy/core/compatibility.py
+++ b/sympy/core/compatibility.py
@@ -7,6 +7,35 @@
 
 import operator
 from collections import defaultdict
+
+# -----------------------------------------------------------------------------
+# Compatibility shim for newer Python versions
+#
+# SymPy historically used abstract base classes from the top-level `collections`
+# module (e.g. `collections.Iterable`). These were moved to `collections.abc`
+# and removed from `collections` in Python 3.10+.  Older SymPy code in this
+# repository still refers to the old locations, so we provide aliases here.
+#
+# This is intentionally centralized to avoid touching many unrelated modules.
+# -----------------------------------------------------------------------------
+import collections
+try:  # Python >= 3.3
+    import collections.abc as _collections_abc
+except Exception:  # pragma: no cover
+    _collections_abc = None
+
+if _collections_abc is not None:
+    for _abc_name in (
+        'Awaitable', 'Coroutine', 'AsyncIterable', 'AsyncIterator',
+        'AsyncGenerator', 'Hashable', 'Iterable', 'Iterator',
+        'Generator', 'Reversible', 'Sized', 'Container', 'Callable',
+        'Collection', 'Set', 'MutableSet', 'Mapping', 'MutableMapping',
+        'MappingView', 'KeysView', 'ItemsView', 'ValuesView',
+        'Sequence', 'MutableSequence',
+    ):
+        if not hasattr(collections, _abc_name) and hasattr(_collections_abc, _abc_name):
+            setattr(collections, _abc_name, getattr(_collections_abc, _abc_name))
+
 from sympy.external import import_module
 
 """
