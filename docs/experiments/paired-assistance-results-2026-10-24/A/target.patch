diff --git a/networkx/algorithms/tests/test_cycles_min_length.py b/networkx/algorithms/tests/test_cycles_min_length.py
new file mode 100644
index 0000000..34f229d
--- /dev/null
+++ b/networkx/algorithms/tests/test_cycles_min_length.py
@@ -0,0 +1,87 @@
+"""Regressions for minimum-length cycle enumeration and its reductions."""
+
+import pytest
+
+import networkx as nx
+from networkx.algorithms import cycles
+
+
+def canonical(cycle, directed):
+    rotations = [tuple(cycle[i:] + cycle[:i]) for i in range(len(cycle))]
+    if not directed:
+        reverse = cycle[::-1]
+        rotations.extend(
+            tuple(reverse[i:] + reverse[:i]) for i in range(len(reverse))
+        )
+    return min(rotations)
+
+
+@pytest.mark.parametrize("kind", [nx.Graph, nx.DiGraph, nx.MultiGraph, nx.MultiDiGraph])
+@pytest.mark.parametrize("upper", [None, 4, 5])
+def test_cycles_sharing_an_articulation_node(kind, upper):
+    G = kind()
+    rings = [[0, 1, 2, 3], [0, 4, 5, 6, 7], [0, 8, 9]]
+    for ring in rings:
+        nx.add_cycle(G, ring)
+        if G.is_directed():
+            nx.add_cycle(G, ring[::-1])
+    before = nx.node_link_data(G, edges="edges")
+    expected = {
+        canonical(c, G.is_directed())
+        for c in nx.simple_cycles(G, upper)
+        if len(c) >= 4
+    }
+    result = [
+        canonical(c, G.is_directed())
+        for c in nx.simple_cycles(G, upper, min_length=4)
+    ]
+    assert len(result) == len(set(result))
+    assert set(result) == expected
+    assert before == nx.node_link_data(G, edges="edges")
+
+
+@pytest.mark.parametrize("directed", [False, True])
+def test_short_blocks_are_not_searched(monkeypatch, directed):
+    G = nx.Graph()
+    G.update(nx.complete_graph(5))
+    G.update(nx.complete_graph(range(4, 9)))
+    nx.add_cycle(G, [8, 9, 10, 11, 12, 13])
+    if directed:
+        G = G.to_directed()
+    # This is a single SCC in the directed case. Size-only SCC pruning cannot
+    # avoid entering the two complete blocks containing only short cycles.
+    searched = []
+    original = cycles._johnson_cycle_search
+
+    def record_search(H, path, min_length=0):
+        searched.append(set(H))
+        yield from original(H, path, min_length)
+
+    monkeypatch.setattr(cycles, "_johnson_cycle_search", record_search)
+    result = list(nx.simple_cycles(G, min_length=6))
+    assert len(result) == (2 if directed else 1)
+    assert searched
+    assert all(len(nodes) >= 6 for nodes in searched)
+    assert all(nodes <= set(range(8, 14)) for nodes in searched)
+
+
+@pytest.mark.parametrize("upper", [None, 5, 6])
+def test_short_closure_still_unblocks_a_longer_cycle(upper):
+    # The first branch closes 0, 4, 2, 5, which is too short. Its success must
+    # still unblock node 2 for the later branch through 3. This applies both
+    # to Johnson's blocked set and Gupta-Suzumura's lock relaxation.
+    G = nx.DiGraph([(0, 4), (2, 5), (3, 2), (4, 2), (4, 3), (5, 0)])
+    assert {
+        canonical(c, True) for c in nx.simple_cycles(G, upper, min_length=5)
+    } == {(0, 4, 3, 2, 5)}
+
+
+def test_minimum_is_keyword_only_and_validated_before_empty_interval():
+    G = nx.DiGraph([(0, 0)])
+    with pytest.raises(TypeError):
+        list(nx.simple_cycles(G, None, 1))
+    with pytest.raises(ValueError, match="minimum length"):
+        list(nx.simple_cycles(G, 0, min_length=-1))
+    with pytest.raises(ValueError, match="length bound"):
+        list(nx.simple_cycles(G, -1, min_length=2))
+    assert list(nx.simple_cycles(G, 0, min_length=0)) == []
