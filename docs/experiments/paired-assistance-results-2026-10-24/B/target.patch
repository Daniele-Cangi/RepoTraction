diff --git a/networkx/algorithms/tests/test_cycles_min_length.py b/networkx/algorithms/tests/test_cycles_min_length.py
new file mode 100644
index 0000000..20d2216
--- /dev/null
+++ b/networkx/algorithms/tests/test_cycles_min_length.py
@@ -0,0 +1,73 @@
+"""Regressions for lower bounds and search component pruning."""
+
+import pytest
+
+import networkx as nx
+from networkx.algorithms import cycles
+
+
+@pytest.mark.parametrize("kind", [nx.Graph, nx.DiGraph, nx.MultiGraph, nx.MultiDiGraph])
+@pytest.mark.parametrize("upper", [None, 6])
+def test_articulation_blocks_are_not_searched(monkeypatch, kind, upper):
+    G = nx.complete_graph(4, create_using=kind)
+    nx.add_cycle(G, [3, 4, 5, 6, 7, 8])
+    # Both pieces share an articulation vertex. In the directed case, add
+    # reverse edges so the entire graph is a single strongly connected piece.
+    if G.is_directed():
+        G.add_edges_from([(v, u) for u, v in list(G.edges())])
+        assert nx.is_strongly_connected(G)
+    before = nx.node_link_data(G, edges="edges")
+    searched = []
+    name = "_johnson_cycle_search" if upper is None else "_bounded_cycle_search"
+    original = getattr(cycles, name)
+
+    def record(component, *args):
+        searched.append(set(component))
+        yield from original(component, *args)
+
+    monkeypatch.setattr(cycles, name, record)
+    result = list(nx.simple_cycles(G, upper, min_length=5))
+    assert len(result) == (2 if G.is_directed() else 1)
+    assert all(set(c) == {3, 4, 5, 6, 7, 8} for c in result)
+    assert searched
+    assert all(len(c) >= 5 and c.isdisjoint({0, 1, 2}) for c in searched)
+    assert nx.node_link_data(G, edges="edges") == before
+
+
+@pytest.mark.parametrize("upper", [None, 5])
+def test_directed_remainders_below_lower_bound_are_not_searched(monkeypatch, upper):
+    G = nx.complete_graph(5, create_using=nx.DiGraph)
+    searched = []
+    name = "_johnson_cycle_search" if upper is None else "_bounded_cycle_search"
+    original = getattr(cycles, name)
+
+    def record(component, *args):
+        searched.append(len(component))
+        yield from original(component, *args)
+
+    monkeypatch.setattr(cycles, name, record)
+    result = list(nx.simple_cycles(G, upper, min_length=5))
+    assert len(result) == 24
+    assert all(len(c) == 5 for c in result)
+    assert searched == [5]
+
+
+@pytest.mark.parametrize("kind", [nx.Graph, nx.DiGraph, nx.MultiGraph, nx.MultiDiGraph])
+def test_short_cycles_and_empty_intervals(kind):
+    G = kind()
+    G.add_edges_from([(0, 0), (0, 1), (0, 1), (1, 0), (1, 2), (2, 0)])
+    assert list(nx.simple_cycles(G, 1, min_length=1)) == [[0]]
+    assert list(nx.simple_cycles(G, 1, min_length=2)) == []
+    assert list(nx.simple_cycles(G, 3, min_length=4)) == []
+    result = list(nx.simple_cycles(G, 3, min_length=3))
+    assert len(result) == 1
+    assert set(result[0]) == {0, 1, 2}
+    with pytest.raises(ValueError, match="minimum length"):
+        list(nx.simple_cycles(G, 0, min_length=-1))
+    with pytest.raises(ValueError, match="length bound"):
+        list(nx.simple_cycles(G, -1, min_length=8))
+
+
+def test_minimum_is_keyword_only():
+    with pytest.raises(TypeError):
+        list(nx.simple_cycles(nx.Graph(), None, 3))
