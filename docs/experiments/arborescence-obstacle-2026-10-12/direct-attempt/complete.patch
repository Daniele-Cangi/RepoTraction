+++ b/networkx/algorithms/tree/tests/test_branchings_integer.py
@@ -0,0 +1,81 @@
+"""Regressions for batched integer arborescence contraction."""
+
+import random
+from copy import deepcopy
+
+import pytest
+
+import networkx as nx
+
+
+@pytest.mark.parametrize("seed", range(40))
+@pytest.mark.parametrize("multigraph", [False, True])
+def test_integer_arborescence_matches_existing_solver(seed, multigraph):
+    rng = random.Random(seed)
+    n = 2 + seed % 7
+    G = nx.MultiDiGraph() if multigraph else nx.DiGraph()
+    # The directed ring guarantees a spanning solution without fixing its root.
+    G.add_weighted_edges_from(
+        (u, (u + 1) % n, rng.randrange(-20, 21)) for u in range(n)
+    )
+    for u in range(n):
+        for v in range(n):
+            if rng.random() < 0.5:
+                G.add_edge(u, v, weight=rng.randrange(-20, 21), label=(u, v))
+    before = deepcopy(G)
+    reference = nx.algorithms.tree.minimal_branching(G.copy())
+    answer = nx.minimum_spanning_arborescence(G, preserve_attrs=True)
+    assert nx.is_arborescence(answer)
+    assert set(answer) == set(G)
+    assert nx.tree.branching_weight(answer) == nx.tree.branching_weight(reference)
+    assert nx.utils.graphs_equal(G, before)
+    for u, v, data in answer.edges(data=True):
+        choices = G[u][v].values() if multigraph else [G[u][v]]
+        assert data in choices
+
+
+def test_integer_arborescence_large_exact_weights_and_root_choice():
+    huge = 10**120
+    G = nx.DiGraph()
+    G.add_weighted_edges_from(
+        [
+            ("a", "b", huge),
+            ("b", "a", -huge),
+            ("a", "c", -huge + 1),
+            ("b", "c", huge),
+            ("c", "a", -huge + 2),
+            ("c", "b", huge + 3),
+        ]
+    )
+    answer = nx.minimum_spanning_arborescence(G)
+    assert nx.is_arborescence(answer)
+    assert set(answer.edges) == {("b", "a"), ("a", "c")}
+    assert nx.tree.branching_weight(answer) == -2 * huge + 1
+
+
+def test_integer_arborescence_disjoint_cycles_then_nested_cycle():
+    G = nx.DiGraph()
+    G.add_weighted_edges_from(
+        [
+            ("r", 0, 20),
+            ("r", 2, 21),
+            (0, 1, 1),
+            (1, 0, 1),
+            (2, 3, 1),
+            (3, 2, 1),
+            (1, 2, 2),
+            (3, 0, 2),
+        ]
+    )
+    answer = nx.minimum_spanning_arborescence(G)
+    assert nx.is_arborescence(answer)
+    assert set(answer) == set(G)
+    assert nx.tree.branching_weight(answer) == 24
+
+
+def test_float_arborescence_uses_existing_behavior():
+    G = nx.DiGraph()
+    G.add_weighted_edges_from([(0, 1, 1.25), (1, 0, 2.5), (1, 2, -0.5)])
+    answer = nx.minimum_spanning_arborescence(G)
+    assert set(answer.edges) == {(0, 1), (1, 2)}
+    assert nx.tree.branching_weight(answer) == 0.75
