+def _minimum_spanning_arborescence_integer(G, attr, default, preserve_attrs):
+    """Batched Edmonds contraction for integer-weight directed graphs.
+
+    A synthetic root makes the root choice part of the optimization. Its
+    incoming-edge penalty exceeds the total possible original weight range,
+    so a feasible spanning arborescence uses exactly one synthetic edge.
+    Integer arithmetic keeps this reduction exact. Contraction scans edge
+    records and saves only chosen edges and vertex membership for expansion,
+    rather than copies of intermediate NetworkX graphs. The worst-case time
+    bound is O(n m), as for the classical Edmonds algorithm cited above.
+    """
+    labels = list(G)
+    n = len(labels)
+    node_index = {node: i for i, node in enumerate(labels)}
+    originals = list(G.edges(data=True))
+    weights = [data.get(attr, default) for _, _, data in originals]
+    # Restrict the fast path to exact integer arithmetic. Preserve the existing
+    # implementation for floats, custom numeric types, and empty graphs.
+    if n == 0 or any(type(weight) is not int for weight in weights):
+        return None
+    low = min(weights, default=0)
+    high = max(weights, default=0)
+    penalty = n * (high - low) + 1
+    targets = [node_index[v] for _, v, _ in originals] + list(range(n))
+    edges = [
+        (node_index[u], node_index[v], weight - low, i)
+        for i, ((u, v, _), weight) in enumerate(zip(originals, weights))
+        if u != v
+    ]
+    first_synthetic = len(originals)
+    root = n
+    edges.extend((root, v, penalty, first_synthetic + v) for v in range(n))
+    size = n + 1
+    membership = list(range(size))
+    history = []
+
+    while True:
+        incoming = [None] * size
+        costs = [None] * size
+        parents = [root] * size
+        for u, v, weight, edge_id in edges:
+            if costs[v] is None or weight < costs[v]:
+                incoming[v] = edge_id
+                costs[v] = weight
+                parents[v] = u
+
+        # The selected incoming edges form disjoint cycles with trees feeding
+        # into them. Contract all cycles in one pass.
+        component = [-1] * size
+        visited = [-1] * size
+        count = 0
+        for start in range(size):
+            v = start
+            while v != root and component[v] == -1 and visited[v] != start:
+                visited[v] = start
+                v = parents[v]
+            if v != root and component[v] == -1:
+                component[v] = count
+                u = parents[v]
+                while u != v:
+                    component[u] = count
+                    u = parents[u]
+                count += 1
+        if count == 0:
+            selected = [edge_id for edge_id in incoming if edge_id is not None]
+            break
+
+        history.append((incoming, membership))
+        for v in range(size):
+            if component[v] == -1:
+                component[v] = count
+                count += 1
+        edges = [
+            (component[u], component[v], weight - costs[v], edge_id)
+            for u, v, weight, edge_id in edges
+            if component[u] != component[v]
+        ]
+        membership = [component[v] for v in membership]
+        root = component[root]
+        size = count
+
+    # Each entering edge replaces the chosen edge at its original target.
+    # Membership records identify that target even through nested cycles.
+    for incoming, membership in reversed(history):
+        for edge_id in selected:
+            incoming[membership[targets[edge_id]]] = edge_id
+        selected = [edge_id for edge_id in incoming if edge_id is not None]
+
+    selected = [edge_id for edge_id in selected if edge_id < first_synthetic]
+    if len(selected) != n - 1:
+        raise nx.NetworkXException("No minimum spanning arborescence in G.")
+    B = G.__class__()
+    B.add_nodes_from(G)
+    for edge_id in selected:
+        u, v, data = originals[edge_id]
+        attrs = dict(data) if preserve_attrs else {}
+        attrs[attr] = data.get(attr, default)
+        B.add_edge(u, v, **attrs)
+    return B
+
+
 @nx._dispatchable(preserve_edge_attrs=True, mutates_input=True, returns_graph=True)
 def minimum_spanning_arborescence(
